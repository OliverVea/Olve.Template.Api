<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- The API surface generated from the contract; -p:SkipSpecGen=true compiles already-emitted files
       without node. -->
  <ItemGroup>
    <TypeSpecContract Include="../../spec/main.tsp" GeneratedDir="../../../artifacts/generated/" />
  </ItemGroup>

  <!-- Copied after publish: a wwwroot Content item would need the file before the first compile. -->
  <Target Name="PublishOpenApiDocument" AfterTargets="Publish">
    <Copy SourceFiles="../../../artifacts/spec/openapi.json" DestinationFiles="$(PublishDir)wwwroot/openapi/v1.json" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Duende.IdentityModel" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Olve.Results" />
    <PackageReference Include="Olve.TypeSpec" />
    <PackageReference Include="Olve.Validation" />
    <PackageReference Include="Olve.Utilities" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>

</Project>
