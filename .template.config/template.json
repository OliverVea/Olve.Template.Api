{
  "$schema": "http://json.schemastore.org/template",
  "author": "Oliver Vea",
  "classifications": [
    "Web",
    "API",
    "Minimal API"
  ],
  "identity": "Olve.Template.Api",
  "name": "Olve API Template",
  "shortName": "olve-api",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Olve.Template.Api",
  "preferNameDirectory": true,
  "symbols": {
    "kebabName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebabCase",
      "replaces": "olve-template-api",
      "fileRename": "olve-template-api"
    }
  },
  "forms": {
    "kebabCase": {
      "identifier": "chain",
      "steps": [
        "dotToHyphen",
        "lowerCaseIt"
      ]
    },
    "dotToHyphen": {
      "identifier": "replace",
      "pattern": "\\.",
      "replacement": "-"
    },
    "lowerCaseIt": {
      "identifier": "lowerCase"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".claude/settings.local.json",
            ".template.config/**",
            "TestResults/**",
            "docs/design/template.md",
            "artifacts/**",
            "data/**",
            "**/node_modules/**",
            "src/frontend/dist/**",
            ".pipelines/.olve/**",
            ".pipelines/bun.lock"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "Makes the scripts and the git hook executable (dotnet new drops file modes).",
      "manualInstructions": [
        {
          "text": "Run 'chmod +x tools/*.sh .githooks/pre-push'"
        }
      ],
      "actionId": "cb9a6cf3-4f5c-4860-b9d2-03a574959774",
      "args": {
        "+x": [
          "tools/check.sh",
          "tools/api-image.sh",
          ".githooks/pre-push"
        ]
      },
      "continueOnError": true
    }
  ]
}
