{
  "$schema": "http://json.schemastore.org/template",
  "author": "Oliver Vea",
  "classifications": [
    "Web",
    "API",
    "Minimal API"
  ],
  "identity": "Olve.Template.Api",
  "name": "Olve API Template",
  "shortName": "olve-api",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Olve.Template.Api",
  "preferNameDirectory": true,
  "symbols": {
    "kebabName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebabCase",
      "replaces": "olve-template-api",
      "fileRename": "olve-template-api"
    },
    "shortName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lastSegment",
      "replaces": "TemplateApi",
      "description": "The installed app's short name: the last part of the service name."
    },
    "pwa": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "An installable web app: a manifest, icons and a service worker that caches the SPA and offers new builds."
    }
  },
  "forms": {
    "kebabCase": {
      "identifier": "chain",
      "steps": [
        "dotToHyphen",
        "lowerCaseIt"
      ]
    },
    "dotToHyphen": {
      "identifier": "replace",
      "pattern": "\\.",
      "replacement": "-"
    },
    "lowerCaseIt": {
      "identifier": "lowerCase"
    },
    "lastSegment": {
      "identifier": "replace",
      "pattern": "^.*\\.",
      "replacement": ""
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".claude/settings.local.json",
            ".claude/worktrees/**",
            ".template.config/**",
            "README.md",
            "TestResults/**",
            "docs/design/template.md",
            "tools/pack/**",
            "template-features.json",
            "artifacts/**",
            "data/**",
            "**/node_modules/**",
            "src/frontend/dist/**",
            ".pipelines/.olve/**",
            ".pipelines/bun.lock"
          ],
          "rename": {
            "docs/README.project.md": "README.md"
          },
          "copyOnly": [
            "**/*.png"
          ]
        },
        {
          "condition": "(!pwa)",
          "exclude": [
            "src/frontend/src/sw/**",
            "src/frontend/src/pwa/**",
            "src/frontend/vite-plugin-sw.ts",
            "src/frontend/public/manifest.webmanifest",
            "src/frontend/public/icons/icon-192.png",
            "src/frontend/public/icons/icon-512.png",
            "src/frontend/public/icons/icon-maskable-512.png",
            "src/backend/Olve.Template.Api.ApiTests/PwaTests.cs"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "Makes the scripts and the git hook executable (dotnet new drops file modes).",
      "manualInstructions": [
        {
          "text": "Run 'chmod +x tools/*.sh .githooks/pre-push'"
        }
      ],
      "actionId": "cb9a6cf3-4f5c-4860-b9d2-03a574959774",
      "args": {
        "+x": [
          "tools/check.sh",
          "tools/api-image.sh",
          "tools/template-parity.ts",
          ".githooks/pre-push"
        ]
      },
      "continueOnError": true
    }
  ]
}
